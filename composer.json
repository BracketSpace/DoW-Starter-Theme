{
    "name": "dow/starter-theme",
    "type": "wordpress-theme",
    "description": "DoW Starter Theme",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "brianhenryie/strauss": "^0.21.0",
        "hassankhan/config": "^3.0",
        "illuminate/collections": "^12.0",
        "illuminate/support": "^12.0",
        "micropackage/acf-block-creator": "^1.0",
        "micropackage/block-loader": "^1.0",
        "micropackage/classnames": "^1.0",
        "micropackage/dochooks": "^1.0",
        "micropackage/filesystem": "^1.1",
        "micropackage/requirements": "^1.2",
        "micropackage/singleton": "^1.1.1",
        "php-di/php-di": "^7.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "php-stubs/acf-pro-stubs": "*",
        "php-stubs/wordpress-stubs": "*",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpstan/phpstan": "^2.1.13",
        "phpstan/phpstan-strict-rules": "^2.0.4",
        "squizlabs/php_codesniffer": "*",
        "szepeviktor/phpcs-psr-12-neutron-hybrid-ruleset": "^1.1.1",
        "szepeviktor/phpstan-wordpress": "^2.0.1",
        "wp-coding-standards/wpcs": "3.1.0 as 2.3.0"
    },
    "autoload": {
        "psr-4": {
            "DoWStarterTheme\\": "src/classes"
        }
    },
    "scripts": {
        "phpcs": "phpcs --parallel=4",
        "phpcbf": "phpcbf --parallel=4",
        "phpcompat": "phpcs --standard=PHPCompatibility --runtime-set testVersion 8.2  --ignore=*/vendor/*,*/node_modules/*,*/build/*,*/dependencies/* --extensions=php --colors .",
        "phpstan": "phpstan analyze -v --memory-limit=-1",
        "syntax": "parallel-lint --exclude node_modules --exclude vendor --exclude dependencies .",
        "test": [
            "@syntax",
            "@phpcompat",
            "@phpstan",
            "@phpcs"
        ],
        "lint": [
            "@syntax",
            "@phpcompat"
        ],
        "prefix-namespaces": [
            "strauss --updateCallSites=false",
            "composer dump-autoload"
        ],
        "post-install-cmd": [
            "@prefix-namespaces"
        ],
        "post-update-cmd": [
            "@prefix-namespaces"
        ]
    },
    "extra": {
        "strauss": {
            "target_directory": "dependencies",
            "namespace_prefix": "DoWStarterTheme\\Deps\\",
            "classmap_prefix": "DOWST_",
            "exclude_from_copy": {
                "packages": [
                    "brianhenryie/strauss"
                ]
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
